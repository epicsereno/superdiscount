# Public site URL — used for canonical tags, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://superdiscount.example.com

# Stripe. Leave unset and /api/checkout returns a clear 501 instead of failing.
# Get these from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Optional analytics
NEXT_PUBLIC_GA4_ID=

# Turn on only after enabling Stripe Tax in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX=false
